{
  "name": "@boardry/cli",
  "version": "0.1.0",
  "description": "The boardry CLI: the document centre for your product.",
  "license": "MIT",
  "keywords": [
    "boardry",
    "cli",
    "docs",
    "knowledge-base",
    "markdown"
  ],
  "type": "module",
  "bin": {
    "boardry": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@boardry/core": "^0.1.0",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "sirv": "^3.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "prepublishOnly": "npm run build"
}

{
  "name": "@boardry/core",
  "version": "0.1.0",
  "description": "The pure TypeScript graph engine and note parser behind boardry.",
  "license": "MIT",
  "keywords": [
    "boardry",
    "knowledge-base",
    "markdown",
    "graph",
    "search"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "graphology": "^0.25.4",
    "minisearch": "^7.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
